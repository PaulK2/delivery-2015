# Cloudflare static-asset caching.
# Vite emits content-hashed files under /assets — safe to cache forever (a new deploy
# produces new filenames). HTML must NOT be cached hard, or new deployments stay hidden.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Vehicle photos/thumbnails are referenced by stable (unhashed) names, so cache a day.
/cars/*
  Cache-Control: public, max-age=86400

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
