{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleetview",
  "compatibility_date": "2026-08-26",
  "main": "worker/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fleetview-db",
      "database_id": "ec90213a-598b-40ad-b0c3-5905c6c1c1d4"
    }
  ]
}
